# ==========================================
# RETAIL INTELLIGENCE LAB - ENVIRONMENT CONFIG
# DTU SE425 Data Warehouse and Data Mining
# ==========================================

# Path to the primary Online Retail CSV dataset
DATASET_PATH=data/Online Retail.csv

# SQLite Warehouse Database URL
DATABASE_URL=sqlite:///data/retail_dw.db

# Server Host & Port
HOST=127.0.0.1
PORT=8000

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Maximum rows to process in CPU-intensive operations (0 for unlimited)
MAX_WORKER_SAMPLE=0
